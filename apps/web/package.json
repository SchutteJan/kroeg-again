    "@tailwindcss/vite": "^4.2.1",
    "lucide-solid": "^0.576.0",
    "maplibre-gl": "^5.21.1",
    "nitro": "3.0.260610-beta",
    "pg": "^8.20.0",
    "solid-js": "^1.9.14",
